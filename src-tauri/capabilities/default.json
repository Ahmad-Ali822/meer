{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimum permissions for Meer Ilyas Software",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:path:default",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "**/*.pdf" },
        { "path": "/**/*.pdf" },
        { "path": "**\\*.pdf" }
      ]
    }
  ]
}
